# Texto e arquivos Unity serializados em YAML
* text=auto
*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.mat text eol=lf
*.inputactions text eol=lf

# Assets binarios devem ser preservados byte a byte
*.fbx binary
*.png binary
*.jpg binary
*.jpeg binary
*.tif binary
*.tiff binary
*.psd binary
*.blend binary
*.unitypackage binary

# Formatos de texto adicionais do Unity
*.anim text eol=lf
*.controller text eol=lf
*.preset text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.shadervariants text eol=lf
*.uss text eol=lf
*.uxml text eol=lf

# Campos vazios do YAML do Unity usam espacos ao final da linha
*.unity whitespace=-blank-at-eol
*.prefab whitespace=-blank-at-eol
*.asset whitespace=-blank-at-eol
*.meta whitespace=-blank-at-eol
*.mat whitespace=-blank-at-eol
*.anim whitespace=-blank-at-eol
*.controller whitespace=-blank-at-eol
*.preset whitespace=-blank-at-eol
*.shadergraph whitespace=-blank-at-eof
